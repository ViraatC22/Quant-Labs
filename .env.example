APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

POSTGRES_DB=quant_labs
POSTGRES_USER=quant_labs
POSTGRES_PASSWORD=quant_labs_dev_password
# Used by the docker-compose stack. Running the API standalone (without Docker)
# defaults to a local SQLite file, so DATABASE_URL can be left unset there.
DATABASE_URL=postgresql+psycopg://quant_labs:quant_labs_dev_password@postgres:5432/quant_labs

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=quant_labs
MINIO_ROOT_PASSWORD=quant_labs_dev_password
MINIO_BUCKET=trading-vault

NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional AI. Research answers use the first configured provider in `auto`
# mode and fall back locally when no key is present. Import enrichment remains
# separately opt-in so adding a chat key does not send every imported source.
AI_ENRICHMENT_MODE=local
RESEARCH_WRITER_MODE=auto
AI_PROVIDER_ORDER=gemini,groq,openrouter,cerebras,ollama,openai
AI_REQUEST_TIMEOUT_SECONDS=18
AI_RATE_LIMIT_COOLDOWN_SECONDS=60
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Memory / retrieval (Lattice merge). The default `local` embedding provider is
# deterministic and needs no network — the research pipeline, semantic search,
# entity resolution, and conflict detection all run offline. Switch to `ollama`
# (nothing leaves the machine) or `openai` for true neural embeddings.
# EMBEDDING_DIM must match the provider AND the vector() column in the migrations
# (default 768 = nomic-embed-text). Changing it requires a follow-up migration.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_ENABLED=false
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
# Entity resolution / conflict thresholds (cosine). Above match → same entity;
# the band down to review → flagged possible duplicate.
ENTITY_MATCH_THRESHOLD=0.88
ENTITY_REVIEW_THRESHOLD=0.80
CONFLICT_SIM_THRESHOLD=0.85
RESEARCH_MAX_SUBQUERIES=4

# Optional later-phase integrations. Leave empty until documented in SETUP_REQUESTS.md.
ANTHROPIC_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
TWELVE_DATA_API_KEY=
FMP_API_KEY=
# Enables POST /api/v1/webhooks/tradingview (needs a paid TradingView plan to
# send). Alerts create/close trade RECORDS only; no orders are ever placed.
# Leave empty to keep the endpoint disabled.
TRADINGVIEW_WEBHOOK_SECRET=
COINGECKO_API_KEY=
